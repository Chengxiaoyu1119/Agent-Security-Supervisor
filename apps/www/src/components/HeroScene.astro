---
import { pipeline, stats } from '../content/homepage';

interface Props {
  consoleUrl: string;
  docsUrl: string;
}

const { consoleUrl, docsUrl } = Astro.props;

const liveEvents = [
  { time: '00:01', title: 'file.read', note: 'untrusted prompt source', state: 'flagged' },
  { time: '00:03', title: 'risk_score', note: 'policy + anomaly fusion', state: '97' },
  { time: '00:05', title: 'decision', note: 'block before tool call', state: 'sealed' }
];
---

<section class="hero" id="top" data-parallax-root>
  <div class="hero__backdrop" aria-hidden="true">
    <span class="hero__beam hero__beam--one"></span>
    <span class="hero__beam hero__beam--two"></span>
    <span class="hero__mesh"></span>
  </div>

  <nav class="nav" aria-label="主导航">
    <a href="#top" class="brand">
      <img src="/favicon.svg" alt="智安哨" />
      <span>
        <strong>智安哨</strong>
        <em>Agent Security Supervisor</em>
      </span>
    </a>
    <div class="nav__links">
      <a href="#capabilities">核心能力</a>
      <a href="#surfaces">攻击面</a>
      <a href="#pipeline">监督流水线</a>
      <a href="#openclaw">OpenClaw</a>
    </div>
    <div class="nav__actions">
      <a href={docsUrl} class="button button--ghost">查看文档</a>
      <a href={consoleUrl} class="button">进入控制台</a>
    </div>
  </nav>

  <div class="hero__layout">
    <div class="hero__copy reveal">
      <p class="hero__kicker"><span></span>Tool-call firewall for LLM agents</p>
      <h1>把 Agent 的危险动作拦在工具调用前</h1>
      <p class="lead">
        智安哨把攻击样本、沙箱工具、策略命中、人工复核和审计证据串成一套可复现的监督闭环，
        让每次敏感调用都有理由、有证据、有回放。
      </p>
      <div class="hero__actions">
        <a href={consoleUrl} class="button button--large">进入控制台</a>
        <a href={docsUrl} class="button button--large button--ghost">阅读文档</a>
      </div>
      <div class="hero__signals" aria-label="核心监督信号">
        <span>before_tool_call</span>
        <span>risk fusion</span>
        <span>audit hash</span>
      </div>
    </div>

    <div class="hero__visual reveal" aria-hidden="true">
      <div class="cockpit" data-tilt>
        <div class="cockpit__topbar">
          <div>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <strong>Live Supervisor</strong>
          <em>online</em>
        </div>

        <div class="cockpit__body">
          <div class="risk-core">
            <span class="risk-core__ring"></span>
            <span class="risk-core__ring risk-core__ring--slow"></span>
            <div>
              <small>Risk Score</small>
              <strong>97</strong>
              <p>critical tool-call hijack</p>
            </div>
          </div>

          <div class="decision-stack">
            <article>
              <small>Attack</small>
              <strong>工具调用劫持</strong>
              <p>code.run / file.read / api.call</p>
            </article>
            <article>
              <small>Decision</small>
              <strong>拒绝执行</strong>
              <p>策略命中 + 异常分融合</p>
            </article>
            <article>
              <small>Evidence</small>
              <strong>audit sealed</strong>
              <p>参数、上下文、复核链路留痕</p>
            </article>
          </div>
        </div>

        <div class="event-stream">
          {liveEvents.map((event) => (
            <div>
              <b>{event.time}</b>
              <span>
                <strong>{event.title}</strong>
                <small>{event.note}</small>
              </span>
              <em>{event.state}</em>
            </div>
          ))}
        </div>
      </div>

      <div class="orbit-strip">
        {pipeline.slice(1, 6).map((item) => <span>{item}</span>)}
      </div>
    </div>
  </div>

  <div class="metrics-grid reveal" aria-label="项目核心指标">
    {stats.map((item) => (
      <article>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
        <p>{item.note}</p>
      </article>
    ))}
  </div>
</section>
