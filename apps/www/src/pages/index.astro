---
import HeroScene from '../components/HeroScene.astro';
import { attackSurfaces, capabilities, demoScenarios, integrations, workflowStages } from '../content/homepage';
import '../styles/global.css';

const consoleUrl = import.meta.env.PUBLIC_AGENT_SUPERVISOR_CONSOLE_URL ?? 'http://127.0.0.1:5178';
const docsUrl = import.meta.env.PUBLIC_AGENT_SUPERVISOR_DOCS_URL ?? 'http://127.0.0.1:3000';
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="智安哨 Agent Security Supervisor，面向 LLM Agent 的攻击复现、工具调用监督、证据留痕与防御评测平台。"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>智安哨 Agent Security Supervisor</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('ass-theme');
      const preferredTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.dataset.theme = savedTheme || preferredTheme;
    </script>
  </head>
  <body>
    <HeroScene consoleUrl={consoleUrl} docsUrl={docsUrl} />

    <main>
      <section class="section workflow-section" id="workflow">
        <div class="section-heading">
          <p class="eyebrow">Workflow</p>
          <h2>不是展示概念，而是把攻击到防御跑成闭环</h2>
          <p>官网主线围绕真实监督链路展开：发现风险、标准化事件、执行前判定、留存证据。</p>
        </div>

        <div class="workflow-board">
          {workflowStages.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p>{item.meta}</p>
                <h3>{item.title}</h3>
                <small>{item.body}</small>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section capability-section" id="capabilities" data-capability-tabs>
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Capabilities</p>
            <h2>官网应该像产品，而不是论文摘要</h2>
          </div>
          <p>这里把能力做成可切换的产品视图，用户能直接理解系统到底能做什么。</p>
        </div>

        <div class="capability-shell">
          <div class="capability-tabs" role="tablist" aria-label="核心能力">
            {capabilities.map((item, index) => (
              <button
                type="button"
                class={index === 0 ? 'is-active' : ''}
                data-capability-tab={index}
                data-capability-item-title={item.title}
                data-capability-item-description={item.description}
                data-capability-item-detail={item.detail}
                aria-selected={index === 0 ? 'true' : 'false'}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{item.title}</strong>
              </button>
            ))}
          </div>

          <article class="capability-panel">
            <p class="eyebrow">Selected Capability</p>
            <h3 data-capability-title>{capabilities[0].title}</h3>
            <p data-capability-description>{capabilities[0].description}</p>
            <div class="capability-proof">
              <span>验证方式</span>
              <strong data-capability-detail>{capabilities[0].detail}</strong>
            </div>
          </article>
        </div>
      </section>

      <section class="section demo-section" id="demo">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Live Demo</p>
            <h2>选择事件，查看监督器如何判定</h2>
          </div>
          <p>这是官网内置的轻量交互，完整攻击剧本和证据链在控制台运行。</p>
        </div>

        <div class="supervisor-demo" data-supervisor-demo>
          <div class="demo-sidebar">
            {demoScenarios.map((scenario, index) => (
              <button
                type="button"
                class={index === 0 ? 'is-active' : ''}
                data-demo-scenario={scenario.id}
                data-source={scenario.source}
                data-tool={scenario.tool}
                data-score={scenario.score}
                data-decision={scenario.decision}
                data-tone={scenario.tone}
                data-reason={scenario.reason}
                data-evidence={scenario.evidence}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{scenario.label}</strong>
                <small>{scenario.tool}</small>
              </button>
            ))}
          </div>

          <div class="event-panel">
            <p class="eyebrow">Incoming Event</p>
            <dl>
              <div>
                <dt>上下文来源</dt>
                <dd data-demo-source>不可信文档</dd>
              </div>
              <div>
                <dt>目标工具</dt>
                <dd><code data-demo-tool>file.read</code></dd>
              </div>
              <div>
                <dt>监督状态</dt>
                <dd data-demo-status>等待运行</dd>
              </div>
            </dl>
            <button type="button" class="button button--primary demo-run" data-demo-run>运行监督</button>
          </div>

          <div class="decision-panel" data-demo-result aria-live="polite" data-tone="danger">
            <div class="decision-score">
              <span>风险分</span>
              <strong data-demo-score>97</strong>
            </div>
            <div>
              <p class="eyebrow">Decision</p>
              <h3 data-demo-decision>拒绝</h3>
              <p data-demo-reason>文档内容试图覆盖系统规则，并诱导读取受保护文件。</p>
              <small data-demo-evidence>策略命中 3 项 · 异常分 88 · audit hash 已生成</small>
            </div>
          </div>
        </div>
      </section>

      <section class="section surface-section" id="surfaces">
        <div class="section-heading">
          <p class="eyebrow">Attack Surfaces</p>
          <h2>7 类攻击面可以点开、比较和复核</h2>
          <p>这里把原来的表格升级成攻击面工作台：左侧选择对象，右侧只保留当前重点。</p>
        </div>

        <div class="surface-workbench" data-surface-workbench>
          <div class="surface-list" role="list">
            {attackSurfaces.map((surface, index) => (
              <button
                type="button"
                class={index === 0 ? 'is-active' : ''}
                data-surface-name={surface.name}
                data-surface-risk={surface.risk}
                data-surface-scripts={surface.scripts}
                data-surface-samples={surface.samples}
                data-surface-focus={surface.focus}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <strong>{surface.name}</strong>
                <span class={`risk risk--${surface.risk}`}>{surface.risk}</span>
              </button>
            ))}
          </div>

          <article class="surface-detail">
            <p class="eyebrow">Current Surface</p>
            <div class="surface-detail__heading">
              <h3 data-surface-output-title>{attackSurfaces[0].name}</h3>
              <span class={`risk risk--${attackSurfaces[0].risk}`} data-surface-output-risk>
                {attackSurfaces[0].risk}
              </span>
            </div>
            <p data-surface-output-focus>{attackSurfaces[0].focus}</p>
            <dl>
              <div>
                <dt>攻击剧本</dt>
                <dd data-surface-output-scripts>{attackSurfaces[0].scripts}</dd>
              </div>
              <div>
                <dt>样本证据</dt>
                <dd data-surface-output-samples>{attackSurfaces[0].samples}</dd>
              </div>
            </dl>
            <ul>
              <li>样本、工具参数和触发条件绑定展示</li>
              <li>策略命中、异常分和最终动作同步记录</li>
              <li>可导出复核报告与 OpenClaw 验收材料</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="section integration-section" id="openclaw">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">OpenClaw</p>
            <h2>作为外部 Agent 的工具调用监督层</h2>
          </div>
          <p>接入方式保持简单，把复杂策略、风险解释和证据沉淀留在智安哨内部。</p>
        </div>

        <div class="integration-lanes">
          {integrations.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section final-cta">
        <div>
          <p class="eyebrow">Start</p>
          <h2>进入控制台，运行完整攻击剧本和监督策略</h2>
        </div>
        <div class="final-cta__actions">
          <a href={docsUrl} class="button button--quiet-light button--large">阅读文档</a>
          <a href={consoleUrl} class="button button--primary button--large">进入控制台</a>
        </div>
      </section>
    </main>

    <script>
      // @ts-nocheck
      const root = document.documentElement;
      const themeToggle = document.querySelector('[data-theme-toggle]');
      const themeLabel = document.querySelector('[data-theme-label]');

      const syncThemeLabel = () => {
        if (!themeLabel) return;
        themeLabel.textContent = root.dataset.theme === 'dark' ? '浅色' : '深色';
      };

      syncThemeLabel();

      themeToggle?.addEventListener('click', () => {
        const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nextTheme;
        localStorage.setItem('ass-theme', nextTheme);
        syncThemeLabel();
      });

      const hero = document.querySelector('.hero');
      const canAnimateHero =
        hero &&
        window.matchMedia('(pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (canAnimateHero) {
        let heroFrame = 0;
        const syncHeroDepth = (event) => {
          window.cancelAnimationFrame(heroFrame);
          heroFrame = window.requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - 0.5;
            const y = (event.clientY - rect.top) / rect.height - 0.5;
            hero.style.setProperty('--hero-shift-x', `${(x * -12).toFixed(2)}px`);
            hero.style.setProperty('--hero-shift-y', `${(y * -8).toFixed(2)}px`);
          });
        };

        hero.addEventListener('pointermove', syncHeroDepth, { passive: true });
        hero.addEventListener('pointerleave', () => {
          hero.style.setProperty('--hero-shift-x', '0px');
          hero.style.setProperty('--hero-shift-y', '0px');
        });
      }

      const heroSupervisor = document.querySelector('[data-hero-supervisor]');
      if (heroSupervisor) {
        const heroCaseButtons = [...heroSupervisor.querySelectorAll('[data-hero-case]')];
        const heroFields = {
          status: heroSupervisor.querySelector('[data-hero-status]'),
          score: heroSupervisor.querySelector('[data-hero-score]'),
          meter: heroSupervisor.querySelector('[data-hero-meter]'),
          note: heroSupervisor.querySelector('[data-hero-note]'),
          attack: heroSupervisor.querySelector('[data-hero-attack]'),
          tool: heroSupervisor.querySelector('[data-hero-tool]'),
          decision: heroSupervisor.querySelector('[data-hero-decision]'),
          evidence: heroSupervisor.querySelector('[data-hero-evidence]')
        };

        const syncHeroCase = (button) => {
          heroCaseButtons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', active ? 'true' : 'false');
          });

          heroSupervisor.dataset.state = button.dataset.status;
          heroFields.status.textContent = button.dataset.status;
          heroFields.score.textContent = button.dataset.score;
          heroFields.meter.style.width = `${button.dataset.progress}%`;
          heroFields.note.textContent = button.dataset.note;
          heroFields.attack.textContent = button.dataset.attack;
          heroFields.tool.textContent = button.dataset.tool;
          heroFields.decision.textContent = button.dataset.decision;
          heroFields.evidence.textContent = button.dataset.evidence;
        };

        heroCaseButtons.forEach((button) => button.addEventListener('click', () => syncHeroCase(button)));
        syncHeroCase(heroCaseButtons[0]);
      }

      const capabilityRoot = document.querySelector('[data-capability-tabs]');
      if (capabilityRoot) {
        const buttons = [...capabilityRoot.querySelectorAll('[data-capability-tab]')];
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            buttons.forEach((entry) => {
              const active = entry === button;
              entry.classList.toggle('is-active', active);
              entry.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            capabilityRoot.querySelector('[data-capability-title]').textContent = button.dataset.capabilityItemTitle;
            capabilityRoot.querySelector('[data-capability-description]').textContent =
              button.dataset.capabilityItemDescription;
            capabilityRoot.querySelector('[data-capability-detail]').textContent = button.dataset.capabilityItemDetail;
          });
        });
      }

      const demoRoot = document.querySelector('[data-supervisor-demo]');
      if (demoRoot) {
        const scenarioButtons = [...demoRoot.querySelectorAll('[data-demo-scenario]')];
        const runButton = demoRoot.querySelector('[data-demo-run]');
        let selectedScenario = scenarioButtons[0];

        const syncScenario = (button) => {
          selectedScenario = button;
          scenarioButtons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          demoRoot.querySelector('[data-demo-source]').textContent = button.dataset.source;
          demoRoot.querySelector('[data-demo-tool]').textContent = button.dataset.tool;
          demoRoot.querySelector('[data-demo-status]').textContent = '等待运行';
        };

        scenarioButtons.forEach((button) => button.addEventListener('click', () => syncScenario(button)));

        runButton?.addEventListener('click', () => {
          const status = demoRoot.querySelector('[data-demo-status]');
          const result = demoRoot.querySelector('[data-demo-result]');
          runButton.disabled = true;
          runButton.textContent = '监督中...';
          status.textContent = '正在评分';
          result.classList.add('is-running');

          window.setTimeout(() => {
            demoRoot.querySelector('[data-demo-score]').textContent = selectedScenario.dataset.score;
            demoRoot.querySelector('[data-demo-decision]').textContent = selectedScenario.dataset.decision;
            demoRoot.querySelector('[data-demo-reason]').textContent = selectedScenario.dataset.reason;
            demoRoot.querySelector('[data-demo-evidence]').textContent = selectedScenario.dataset.evidence;
            result.dataset.tone = selectedScenario.dataset.tone;
            result.classList.remove('is-running');
            status.textContent = '判定完成';
            runButton.disabled = false;
            runButton.textContent = '再次运行';
          }, 560);
        });
      }

      const surfaceRoot = document.querySelector('[data-surface-workbench]');
      if (surfaceRoot) {
        const surfaceButtons = [...surfaceRoot.querySelectorAll('[data-surface-name]')];
        surfaceButtons.forEach((button) => {
          button.addEventListener('click', () => {
            surfaceButtons.forEach((item) => {
              const active = item === button;
              item.classList.toggle('is-active', active);
              item.setAttribute('aria-pressed', active ? 'true' : 'false');
            });

            surfaceRoot.querySelector('[data-surface-output-title]').textContent = button.dataset.surfaceName;
            surfaceRoot.querySelector('[data-surface-output-focus]').textContent = button.dataset.surfaceFocus;
            surfaceRoot.querySelector('[data-surface-output-scripts]').textContent = button.dataset.surfaceScripts;
            surfaceRoot.querySelector('[data-surface-output-samples]').textContent = button.dataset.surfaceSamples;

            const risk = surfaceRoot.querySelector('[data-surface-output-risk]');
            risk.textContent = button.dataset.surfaceRisk;
            risk.className = `risk risk--${button.dataset.surfaceRisk}`;
          });
        });
      }
    </script>
  </body>
</html>
