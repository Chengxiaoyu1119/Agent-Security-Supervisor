{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start:console",
      "type": "shell",
      "command": ".\\node_modules\\.bin\\vite.cmd --host 127.0.0.1 --port 5178 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/apps/console"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "start:api",
      "type": "shell",
      "command": "python -X utf8 -m apps.api.dev_server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "start:docs",
      "type": "shell",
      "command": ".\\node_modules\\.bin\\docusaurus.cmd start --host 127.0.0.1 --port 3000 --no-open",
      "options": {
        "cwd": "${workspaceFolder}/apps/docs"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
