{
  "name": "agent-security-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run console:dev",
    "console:dev": "npm --prefix apps/console run dev",
    "console:build": "npm --prefix apps/console run build",
    "console:preview": "npm --prefix apps/console run preview",
    "console:lint": "npm --prefix apps/console run lint",
    "console:lint:strict": "npm --prefix apps/console run lint:strict",
    "console:format": "npm --prefix apps/console run format",
    "console:format:check": "npm --prefix apps/console run format:check",
    "console:test": "npm --prefix apps/console run test",
    "ui:audit": "npm --prefix apps/console run ui:audit",
    "api": "npm run api:dev",
    "api:dev": "python -X utf8 -m uvicorn apps.api.agent_supervisor.main:app --host 127.0.0.1 --port 8012",
    "api:cli": "python -X utf8 -m apps.api.agent_supervisor.cli",
    "cli": "npm run api:cli --",
    "api:check": "python -X utf8 -m compileall apps/api/agent_supervisor",
    "api:test": "python -X utf8 -m unittest discover -s apps/api/tests -p \"test_*.py\"",
    "www:dev": "npm --prefix apps/www run dev",
    "www:build": "npm --prefix apps/www run build",
    "www:preview": "npm --prefix apps/www run preview",
    "docs:dev": "npm --prefix apps/docs run start",
    "docs:build": "npm --prefix apps/docs run build",
    "docs:serve": "npm --prefix apps/docs run serve",
    "self:review": "node scripts/project-self-review.mjs --output apps/api/sandbox/reports",
    "verify": "npm run console:lint:strict && npm run ui:audit && npm run console:test && npm run api:check && npm run api:test && npm run console:build && npm run www:build && npm run docs:build"
  }
}
