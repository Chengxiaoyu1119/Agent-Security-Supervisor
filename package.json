{
  "name": "zhian-shao-agent-security",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api": "python -X utf8 -m uvicorn backend.zhian.main:app --host 127.0.0.1 --port 8012",
    "cli": "python -X utf8 -m backend.zhian.cli",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "ui:audit": "node scripts/frontend-governance-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "backend:check": "python -X utf8 -m compileall backend/zhian",
    "test:backend": "python -X utf8 -m unittest discover -s backend/tests -p \"test_*.py\"",
    "verify": "npm run lint:strict && npm run format:check && npm run ui:audit && npm run test && npm run backend:check && npm run test:backend && npm run build",
    "self:review": "node scripts/project-self-review.mjs --output backend/sandbox/reports"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "antd": "^6.4.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^24.1.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
