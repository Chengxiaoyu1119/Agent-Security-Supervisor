# Optional real model providers. The platform works without keys through the local simulator.
MODEL_REAL_API_ENABLED=true
MODEL_PROVIDER_PRIORITY=deepseek,zhipu
MODEL_TIMEOUT_SECONDS=12

# DeepSeek OpenAI-compatible chat endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Zhipu / BigModel chat endpoint.
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-5.1
