# Optional real model providers. The platform works without keys through the local simulator.
MODEL_REAL_API_ENABLED=false
MODEL_PROVIDER_PRIORITY=deepseek,zhipu
MODEL_TIMEOUT_SECONDS=12

# Public demo mode can disable API token checks. Keep true only if you intentionally expose the API without auth.
AGENT_SUPERVISOR_AUTH_DISABLED=true
AGENT_SUPERVISOR_API_TOKEN=

# DeepSeek OpenAI-compatible chat endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Zhipu / BigModel chat endpoint.
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4.6v-flashx
